generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  handle    String?
  role      String
  email     String
  intro     String
  location  String
  github    String?
  linkedin  String?
  leetcode  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id           String   @id @default(cuid())
  role         String
  company      String
  period       String
  url          String?
  description  String
  techStack    String[]
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String
  description      String
  techStack        String[]
  url              String?
  github           String?
  featured         Boolean  @default(false)
  status           String   @default("development")
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Education {
  id           String   @id @default(cuid())
  degree       String
  school       String
  period       String
  grade        String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Skill {
  id           String   @id @default(cuid())
  name         String
  category     String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
